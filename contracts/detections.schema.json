{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team-45.local/off-ice-flag/detections.schema.json",
  "title": "OffIceFlagDetections",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "available", "objects"],
  "properties": {
    "contract_version": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "available": {
      "type": "boolean",
      "description": "False when the segment has no YOLO sidecar or no readable labels. The page omits the in-frame line."
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "count"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "available": { "const": false } },
        "required": ["available"]
      },
      "then": { "properties": { "objects": { "maxItems": 0 } } }
    }
  ]
}
